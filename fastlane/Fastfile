# frozen_string_literal: true

# Stakura - App Store release lanes (TestFlight + App Store).
#
# PREREQUISITES:
#   - macOS with Xcode 15+ installed (optionally pin a version with
#     xcode-select, or set DEVELOPER_DIR).
#   - Ruby 3.x. Using bundler is optional; a plain `gem install fastlane`
#     works too.
#   - The native iOS project must already exist locally (see the steps in
#     capacitor.config.ts: `npx cap add ios`, then `npx cap sync`).
#   - App Store Connect API key created with the Developer role.
#   - A private .env file (NOT committed) exporting ASC_KEY_ID,
#     ASC_ISSUER_ID and ASC_KEY_CONTENT, sourced before running fastlane.
#
# COMMANDS:
#   - fastlane testflight   # build with gym, upload to TestFlight with pilot
#   - fastlane release      # build, then upload metadata + ipa with deliver
#   - fastlane screenshots  # smoke screenshots via Maestro (placeholder)
#
# SECURITY:
#   - ASC API keys and signing certificates are NEVER committed to this
#     repository. They are provided through ENV (private .env or CI secrets)
#     and certificates are managed manually or with match on a private repo.
#   - The web build under docs/ stays free of ads, tracking and keys.
#
# VERSIONING:
#   - package.json is the single source of truth. Run `bun run check:version`
#     before uploading. The App Store Connect version must equal 1.0.0 for
#     this submission.

default_platform(:ios)

platform :ios do
  before_all do
    # Keep it minimal: only warn when the working tree is dirty, so builds
    # stay reproducible without blocking exploratory work.
    dirty = `git status --porcelain`.strip
    UI.important('Working tree is not clean; the ipa may not map to a committed revision.') unless dirty.empty?
  end

  # App Store Connect API key assembled from private ENV variables.
  private_lane :asc_api_key do
    UI.user_error!('ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT are not set. Source your private .env first.') if ENV['ASC_KEY_ID'].to_s.empty?

    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      # Base64-encoded contents of the .p8 API key file.
      key_content: ENV['ASC_KEY_CONTENT'],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc 'Build the Capacitor iOS app and upload it to TestFlight'
  lane :testflight do
    api_key = asc_api_key

    gym(
      project: 'ios/App/App.xcworkspace',
      scheme: 'App',
      export_method: 'app-store',
      clean: true
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc 'Build the app, then upload the ipa and metadata to App Store Connect'
  lane :release do
    api_key = asc_api_key

    gym(
      project: 'ios/App/App.xcworkspace',
      scheme: 'App',
      export_method: 'app-store',
      clean: true
    )

    deliver(
      api_key: api_key,
      # Metadata and screenshots live in fastlane/metadata (created locally
      # with `fastlane deliver init`; never contains secrets).
      metadata_path: 'fastlane/metadata',
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc 'Smoke screenshots (placeholder)'
  lane :screenshots do
    # Placeholder lane. Stakura is a WKWebView app, so fastlane snapshot
    # cannot see the DOM. Capture screenshots with Maestro instead:
    #
    #   maestro test maestro/flows
    #
    # Maestro drives the real app (tap PLAY, drop blocks, reach game over)
    # and can save screenshots per flow via the `maestro screenshot` command
    # or recorders. Add a dedicated capture flow here before submission.
    UI.message('Screenshot capture is handled with Maestro: run `maestro test maestro/flows`.')
  end
end
