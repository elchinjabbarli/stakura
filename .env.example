# =====================================================================
#  PRIVATE DEV ONLY -- TEMPLATE WITH EMPTY VALUES, NEVER FILL IN HERE
# =====================================================================
# Copy this file to .env for local development and release tooling.
# The real .env is gitignored and NEVER gets committed to this repo.
# The public web build (docs/) must never contain any keys.
# Store-build monetization adapters are injected from the private
# environment at build time -- never from this repository.
# =====================================================================

# App Store Connect API key (used by fastlane lanes; Developer role).
# ASC_KEY_CONTENT is the base64-encoded contents of the .p8 key file.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=

# Store build monetization (stubbed adapter interfaces live in
# src/platform/store.ts; real SDK keys only exist in the private env).
ADMOB_APP_ID=
STORE_IAP_CONFIG_JSON=

# Optional private telemetry / backend endpoints.
SUPABASE_URL=
SUPABASE_ANON_KEY=
